---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { SITE_CONFIG, buildWhatsAppUrl } from '../config/site';
import { SITE_IMAGES } from '../data/gallery';

const whatsappUrl = buildWhatsAppUrl();

const pillars = [
  {
    title: 'Avaliação técnica transparente',
    desc: 'Cada equipamento passa por análise em bancada para identificar a causa real do problema antes de qualquer recomendação.',
  },
  {
    title: 'Execução mediante aprovação',
    desc: 'Explicamos as opções técnicas disponíveis e só iniciamos o serviço após a aprovação do orçamento pelo cliente.',
  },
  {
    title: 'Cuidado com hardware e dados',
    desc: 'Trabalhamos com organização, ferramentas adequadas e atenção à integridade física e lógica dos equipamentos.',
  },
  {
    title: 'Atendimento próximo e objetivo',
    desc: 'Comunicação clara, sem termos complicados sem necessidade, para ajudar você a tomar a melhor decisão.',
  },
];
---

<BaseLayout
  title="Conheça a RECUPERATECH | Grupo INTERATECH"
  description="Conheça a RECUPERATECH, marca do Grupo INTERATECH especializada em montagem, manutenção, upgrade e assistência técnica de computadores e notebooks em Volta Redonda - RJ."
  canonicalPath="/sobre-nos/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Sobre nós', url: '/sobre-nos/' },
  ]}
>
  <section class="page-hero diag-grid-bg">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Sobre nós</span>
      </nav>
      <h1 class="page-hero__title">Sobre a RECUPERATECH</h1>
      <p class="page-hero__subtitle">
        Especialização em montagem, manutenção, upgrades e soluções técnicas para computadores e notebooks em Volta Redonda - RJ.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container about-grid">
      <div class="about-content">
        <span class="eyebrow">Quem somos</span>
        <h2 class="section-title diag-accent-bar">
          RECUPERATECH — Uma marca do {SITE_CONFIG.group}
        </h2>
        <p>
          A <strong>RECUPERATECH</strong> integra o <strong>{SITE_CONFIG.group}</strong> com foco dedicado à montagem, manutenção, personalização, upgrades e assistência técnica de computadores e notebooks.
        </p>
        <p>
          Atendemos clientes que precisam de um computador confiável para trabalhar, estudar, jogar ou produzir, além de quem enfrenta falhas, lentidão, aquecimento ou danos físicos no equipamento.
        </p>
        <p>
          Nosso compromisso é oferecer soluções técnicas bem executadas, com orientação clara na escolha de componentes e transparência em cada etapa do atendimento.
        </p>

        <div class="about-actions">
          <a href="/servicos/" class="btn btn--secondary-light">
            Conhecer nossos serviços
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
            data-track="whatsapp_click"
            data-cta-position="about_page"
            data-service-category="geral"
          >
            Solicitar orçamento
          </a>
        </div>
      </div>

      <div class="about-media">
        <img
          src={SITE_IMAGES.montagem.src}
          alt={SITE_IMAGES.montagem.alt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section section--light">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Nossa forma de trabalhar</span>
        <h2 class="section-title">Compromisso técnico do contato inicial à entrega</h2>
        <p class="section-lead">
          Unimos conhecimento em hardware e software para indicar apenas o que faz sentido para o seu equipamento.
        </p>
      </div>

      <div class="grid-2">
        {pillars.map((pillar) => (
          <div class="pillar-card">
            <h3 class="pillar-card__title">{pillar.title}</h3>
            <p class="pillar-card__desc">{pillar.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBlock
    title="Quer conversar sobre o seu computador ou notebook?"
    subtitle="Fale diretamente com a equipe da RECUPERATECH pelo WhatsApp ou visite nossa unidade na Vila Santa Cecília."
    buttonLabel="SOLICITAR ORÇAMENTO"
    ctaPosition="about_final_cta"
    secondaryLabel="Ver endereço e contato"
    secondaryHref="/contato/"
  />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 3.5rem;
    }
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 1.02rem;
  }

  .about-content strong {
    color: var(--color-black);
  }

  .about-actions {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .about-media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
    background-color: var(--color-black);
  }

  .about-media img {
    width: 100%;
    height: auto;
  }

  .pillar-card {
    background-color: var(--color-white-pure);
    border: 1px solid var(--color-gray-200);
    border-left: 4px solid var(--color-red);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .pillar-card__title {
    font-size: 1.12rem;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .pillar-card__desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
</style>
