---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG, buildWhatsAppUrl } from '../config/site';

const whatsappUrl = buildWhatsAppUrl();
const hasFormEndpoint = Boolean(SITE_CONFIG.contactFormEndpoint);
---

<BaseLayout
  title="Contato e Orçamento | RECUPERATECH Volta Redonda"
  description="Entre em contato com a RECUPERATECH em Volta Redonda - RJ. Solicite orçamento pelo WhatsApp, telefone ou visite a Rua 16, 65 - Vila Santa Cecília."
  canonicalPath="/contato/"
  breadcrumbs={[
    { name: 'Home', url: '/' },
    { name: 'Contato', url: '/contato/' },
  ]}
>
  <section class="page-hero diag-grid-bg">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Contato</span>
      </nav>
      <h1 class="page-hero__title">Contato e Orçamento</h1>
      <p class="page-hero__subtitle">
        Fale diretamente com a RECUPERATECH pelo WhatsApp ou telefone para solicitar avaliação e orçamento.
      </p>
    </div>
  </section>

  <section class="section section--white">
    <div class="container contact-grid">
      <div class="contact-info-panel">
        <span class="eyebrow">Canais diretos</span>
        <h2 class="section-title diag-accent-bar">{SITE_CONFIG.fullTitle}</h2>
        <p class="section-lead">
          O WhatsApp é o canal mais rápido para enviar detalhes do seu computador ou notebook e solicitar orçamento.
        </p>

        <div class="contact-actions">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
            data-track="whatsapp_click"
            data-cta-position="contact_page_primary"
            data-service-category="geral"
          >
            Iniciar conversa no WhatsApp
          </a>
          <a
            href={SITE_CONFIG.phone.href}
            class="btn btn--secondary-light"
            data-track="phone_click"
            data-cta-position="contact_page_primary"
            data-service-category="geral"
          >
            Ligar: {SITE_CONFIG.phone.display}
          </a>
        </div>

        <dl class="contact-details">
          <div>
            <dt>Telefone e WhatsApp</dt>
            <dd>{SITE_CONFIG.phone.display}</dd>
          </div>
          <div>
            <dt>Endereço</dt>
            <dd>{SITE_CONFIG.address.full}</dd>
          </div>
          <div>
            <dt>Redes Sociais</dt>
            <dd class="contact-socials">
              <a href={SITE_CONFIG.social.instagram} target="_blank" rel="noopener noreferrer">
                Instagram (@recuperatech.vr)
              </a>
              <a href={SITE_CONFIG.social.facebook} target="_blank" rel="noopener noreferrer">
                Facebook (Recupera Tech)
              </a>
            </dd>
          </div>
        </dl>

        <div class="contact-route">
          <a
            href={SITE_CONFIG.maps.queryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline-red btn--sm"
          >
            Abrir rota no Google Maps
          </a>
        </div>
      </div>

      <div class="contact-form-panel">
        <h2 class="contact-form-panel__title">Solicitar atendimento por mensagem</h2>
        <p class="contact-form-panel__desc">
          {hasFormEndpoint
            ? 'Preencha os campos abaixo para enviar sua solicitação.'
            : 'Preencha os dados abaixo para montar sua mensagem e abrir diretamente no WhatsApp da RECUPERATECH.'}
        </p>

        <form
          id="contact-form"
          class="contact-form"
          data-endpoint={SITE_CONFIG.contactFormEndpoint}
          data-whatsapp-number={SITE_CONFIG.whatsapp.number}
        >
          <div class="form-field">
            <label for="contact-name">Nome *</label>
            <input id="contact-name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="form-field">
            <label for="contact-phone">Telefone / WhatsApp *</label>
            <input
              id="contact-phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              placeholder="(24) 99999-9999"
            />
          </div>

          <div class="form-field">
            <label for="contact-service">Serviço desejado *</label>
            <select id="contact-service" name="service" required>
              <option value="">Selecione uma opção</option>
              <option value="Montagem e Personalização">Montagem e Personalização</option>
              <option value="Upgrades de Hardware">Upgrades de Hardware</option>
              <option value="Manutenção Preventiva">Manutenção Preventiva</option>
              <option value="Software e Otimização">Software e Otimização</option>
              <option value="Manutenção de Notebooks">Manutenção de Notebooks</option>
              <option value="Backup e Recuperação de Dados">Backup e Recuperação de Dados</option>
              <option value="Diagnóstico e Suporte">Diagnóstico e Suporte</option>
            </select>
          </div>

          <div class="form-field">
            <label for="contact-message">Mensagem *</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="Descreva seu computador/notebook e o que você precisa."
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary" id="contact-submit-btn">
            {hasFormEndpoint ? 'Enviar solicitação' : 'Enviar pelo WhatsApp'}
          </button>

          <p id="contact-form-status" class="form-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--light section--compact">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Localização</span>
        <h2 class="section-title">Mapa de localização — Vila Santa Cecília</h2>
        <p class="section-lead">{SITE_CONFIG.address.full}</p>
      </div>

      <div class="contact-map">
        <iframe
          title="Mapa da RECUPERATECH — Rua 16, 65 - Vila Santa Cecília, Volta Redonda - RJ"
          src={SITE_CONFIG.maps.embedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('contact-form');
    var statusEl = document.getElementById('contact-form-status');
    var submitBtn = document.getElementById('contact-submit-btn');
    if (!form || !statusEl || !submitBtn) return;

    var formStarted = false;
    form.addEventListener('focusin', function () {
      if (formStarted) return;
      formStarted = true;
      if (typeof window.recuperatechTrack === 'function') {
        window.recuperatechTrack('form_start', {
          cta_position: 'contact_form',
          service_category: 'geral',
        });
      }
    });

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var data = new FormData(form);
      var name = String(data.get('name') || '').trim();
      var phone = String(data.get('phone') || '').trim();
      var service = String(data.get('service') || '').trim();
      var message = String(data.get('message') || '').trim();
      var endpoint = form.getAttribute('data-endpoint') || '';
      var waNumber = form.getAttribute('data-whatsapp-number') || '5524992433013';

      if (!endpoint) {
        // Sem backend de formulário configurado: redireciona com segurança para o WhatsApp oficial
        // sem simular envio falso no site.
        var composed =
          'Olá! Meu nome é ' +
          name +
          ' (Telefone: ' +
          phone +
          ').\nServiço de interesse: ' +
          service +
          '.\nMensagem: ' +
          message;
        if (typeof window.recuperatechTrack === 'function') {
          window.recuperatechTrack('whatsapp_click', {
            cta_position: 'contact_form_whatsapp',
            service_category: service || 'geral',
          });
        }
        window.open(
          'https://wa.me/' + waNumber + '?text=' + encodeURIComponent(composed),
          '_blank',
          'noopener,noreferrer'
        );
        statusEl.hidden = false;
        statusEl.textContent = 'Abrindo conversa no WhatsApp com a sua mensagem preenchida.';
        return;
      }

      submitBtn.disabled = true;
      statusEl.hidden = false;
      statusEl.textContent = 'Enviando sua solicitação...';

      if (typeof window.recuperatechTrack === 'function') {
        window.recuperatechTrack('form_submit', {
          cta_position: 'contact_form',
          service_category: service || 'geral',
        });
      }

      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ name: name, phone: phone, service: service, message: message }),
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Falha no envio');
          statusEl.textContent = 'Solicitação enviada com sucesso. Em breve retornaremos o contato.';
          form.reset();
          if (typeof window.recuperatechTrack === 'function') {
            window.recuperatechTrack('generate_lead', {
              cta_position: 'contact_form',
              service_category: service || 'geral',
            });
          }
        })
        .catch(function () {
          statusEl.textContent =
            'Não foi possível enviar pelo formulário neste momento. Por favor, utilize o WhatsApp ou telefone (24) 99243-3013.';
        })
        .finally(function () {
          submitBtn.disabled = false;
        });
    });
  })();
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
  }

  .contact-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .contact-details {
    margin: 2rem 0 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-gray-200);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .contact-details dt {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-red);
    margin-bottom: 0.2rem;
  }

  .contact-details dd {
    margin: 0;
    color: var(--color-text-dark);
    font-weight: 500;
  }

  .contact-socials {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .contact-socials a {
    color: var(--color-black);
    text-decoration: underline;
  }

  .contact-form-panel {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-top: 4px solid var(--color-red);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .contact-form-panel__title {
    font-size: 1.35rem;
    color: var(--color-black);
    margin-bottom: 0.45rem;
  }

  .contact-form-panel__desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
    margin-bottom: 1.35rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-field label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-black);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 0.72rem 0.85rem;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--color-black);
    background-color: var(--color-white-pure);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-sm);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: 2px solid var(--color-red);
    outline-offset: 1px;
    border-color: var(--color-red);
  }

  .form-status {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-black);
    padding: 0.7rem 0.9rem;
    background-color: var(--color-gray-100);
    border-radius: var(--radius-sm);
  }

  .contact-map {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
  }

  .contact-map iframe {
    width: 100%;
    height: 380px;
    border: 0;
    display: block;
  }
</style>
