---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBlock from '../components/CtaBlock.astro';
import { SITE_CONFIG, buildWhatsAppUrl } from '../config/site';
import { HOME_SERVICE_CARDS } from '../data/services';
import { SITE_IMAGES } from '../data/gallery';
import { HOME_FAQS } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const heroWhatsappUrl = buildWhatsAppUrl();
const customBuildWhatsappUrl = buildWhatsAppUrl(
  'Olá! Vim pelo site da RECUPERATECH e gostaria de solicitar um orçamento para montagem de computador.'
);
const upgradeWhatsappUrl = buildWhatsAppUrl(
  'Olá! Quero melhorar o desempenho do meu computador e gostaria de consultar as opções de upgrade.'
);
const differentialsWhatsappUrl = buildWhatsAppUrl(
  'Olá! Gostaria de conversar com a RECUPERATECH sobre uma avaliação técnica para o meu equipamento.'
);

const differentials = [
  {
    title: 'Soluções para diferentes necessidades',
    desc: 'Atendimento estruturado para máquinas de uso pessoal, estudos, trabalho, escritório e setups gamer.',
  },
  {
    title: 'Atendimento personalizado',
    desc: 'Escutamos o seu objetivo e o comportamento do equipamento antes de indicar qualquer serviço.',
  },
  {
    title: 'Avaliação técnica',
    desc: 'Análise em bancada para identificar a real origem do problema e apresentar orçamento transparente.',
  },
  {
    title: 'Orientação para escolha de componentes',
    desc: 'Apoio técnico na seleção de peças compatíveis e equilibradas para o seu projeto ou upgrade.',
  },
  {
    title: 'Montagem e manutenção de computadores',
    desc: 'Execução cuidadosa na montagem, organização de cabos, limpeza interna e manutenção preventiva.',
  },
  {
    title: 'Suporte em soluções de hardware e software',
    desc: 'Cobertura integrada entre reparos físicos, upgrades, sistema operacional, otimização e backup.',
  },
];

const steps = [
  {
    num: '01',
    title: 'Entre em contato',
    desc: 'Fale conosco pelo WhatsApp ou telefone e informe qual equipamento você utiliza.',
  },
  {
    num: '02',
    title: 'Explique sua necessidade',
    desc: 'Descreva se deseja montar um PC, fazer um upgrade ou resolver uma falha específica.',
  },
  {
    num: '03',
    title: 'Receba a avaliação e o orçamento',
    desc: 'Realizamos a análise técnica necessária e apresentamos o orçamento detalhado para sua análise.',
  },
  {
    num: '04',
    title: 'Aprove a execução do serviço',
    desc: 'A execução do serviço só acontece após a sua aprovação expressa do orçamento apresentado.',
  },
];
---

<BaseLayout
  title="Montagem e Manutenção de PCs em Volta Redonda | RECUPERATECH"
  description="Montagem de computadores, upgrades, manutenção de PCs e notebooks em Volta Redonda - RJ. Solicite seu orçamento à RECUPERATECH."
  canonicalPath="/"
  extraSchemas={[faqSchema]}
>
  <!-- Seção 1 — Hero / Banner principal -->
  <section class="hero section--dark diag-grid-bg">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="hero__location">Atendimento em Volta Redonda - RJ.</p>
        <h1 class="hero__title">SEU COMPUTADOR MERECE O MELHOR CUIDADO.</h1>
        <p class="hero__subtitle">
          Montagem, manutenção, upgrades e soluções em tecnologia para computadores e notebooks.
        </p>

        <div class="hero__actions">
          <a
            href={heroWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--primary"
            data-track="whatsapp_click"
            data-cta-position="hero_primary"
            data-service-category="geral"
          >
            Solicitar orçamento pelo WhatsApp
          </a>
          <a href="/servicos/" class="btn btn--secondary-dark">
            Conhecer nossos serviços
          </a>
        </div>

        <p class="hero__brand-note">
          <strong>{SITE_CONFIG.name}</strong> — Uma marca do {SITE_CONFIG.group} · {SITE_CONFIG.address.neighborhood}
        </p>
      </div>

      <div class="hero__media">
        <img
          src={SITE_IMAGES.hero.src}
          alt={SITE_IMAGES.hero.alt}
          width="1200"
          height="750"
          loading="eager"
          decoding="sync"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Seção 2 — Apresentação -->
  <section class="section section--white">
    <div class="container intro-grid">
      <div>
        <span class="eyebrow">Especialistas em tecnologia</span>
        <h2 class="section-title diag-accent-bar">
          Soluções técnicas para computadores e notebooks com foco em confiança e qualidade
        </h2>
      </div>
      <div class="intro-grid__body">
        <p>
          A <strong>RECUPERATECH</strong>, marca integrante do <strong>Grupo INTERATECH</strong>, atua com montagem, manutenção, personalização, upgrades e assistência técnica para computadores e notebooks em Volta Redonda - RJ.
        </p>
        <p>
          Nosso trabalho une diagnóstico técnico criterioso, transparência no orçamento e atenção aos detalhes em cada bancada, ajudando você a extrair o melhor do seu equipamento com segurança.
        </p>
        <div class="intro-grid__cta">
          <a href="/sobre-nos/" class="btn btn--secondary-light">
            Conheça a RECUPERATECH
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção 3 — Principais serviços -->
  <section class="section section--light" id="principais-servicos">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Principais serviços</span>
        <h2 class="section-title">Como podemos ajudar o seu equipamento</h2>
        <p class="section-lead">
          Conheça as principais áreas de atendimento da RECUPERATECH e acesse os detalhes de cada categoria.
        </p>
      </div>

      <div class="grid-3">
        {HOME_SERVICE_CARDS.map((card) => {
          const img = SITE_IMAGES[card.imageKey];
          return (
            <article class="home-service-card">
              <div class="home-service-card__media">
                <img
                  src={img.src}
                  alt={img.alt}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="home-service-card__body">
                <h3 class="home-service-card__title">{card.title}</h3>
                <p class="home-service-card__desc">{card.description}</p>
                <a href={card.href} class="home-service-card__link">
                  Ver detalhes do serviço &rarr;
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div class="section-footer-cta">
        <a href="/servicos/" class="btn btn--secondary-light">
          Ver todos os serviços
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 4 — Montagem personalizada -->
  <section class="section section--dark">
    <div class="container split-feature">
      <div class="split-feature__media">
        <img
          src={SITE_IMAGES.custom.src}
          alt={SITE_IMAGES.custom.alt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="split-feature__content">
        <span class="eyebrow">Montagem personalizada</span>
        <h2 class="section-title">Computadores montados sob medida para o seu objetivo</h2>
        <p class="section-lead">
          Orientamos a escolha de componentes compatíveis e executamos a montagem completa com atenção ao fluxo de ar e organização interna.
        </p>

        <ul class="check-list">
          <li>Computadores gamer</li>
          <li>Computadores para escritório</li>
          <li>Computadores para estudos e produtividade</li>
          <li>Computadores com water cooler e RGB</li>
          <li>Projetos personalizados conforme necessidade e orçamento</li>
        </ul>

        <a
          href={customBuildWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          data-track="whatsapp_click"
          data-cta-position="home_custom_build"
          data-service-category="montagem"
        >
          Quero montar meu computador
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 5 — Upgrades e manutenção -->
  <section class="section section--white">
    <div class="container split-feature split-feature--reverse">
      <div class="split-feature__media">
        <img
          src={SITE_IMAGES.upgrade.src}
          alt={SITE_IMAGES.upgrade.alt}
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="split-feature__content">
        <span class="eyebrow">Upgrades e manutenção</span>
        <h2 class="section-title">Mais fôlego e estabilidade para o seu computador atual</h2>
        <p class="section-lead">
          Nem sempre é necessário trocar de máquina. Avaliamos o seu equipamento para indicar atualizações e cuidados preventivos compatíveis com o seu hardware:
        </p>

        <ul class="check-list check-list--light">
          <li><strong>Troca de HD por SSD:</strong> reduz o tempo de inicialização e agiliza a abertura de programas.</li>
          <li><strong>Expansão de memória RAM:</strong> melhora a fluidez ao trabalhar com múltiplos aplicativos.</li>
          <li><strong>Instalação de placas de vídeo:</strong> amplia a capacidade gráfica respeitando fonte e gabinete.</li>
          <li><strong>Limpeza interna e troca de pasta térmica:</strong> favorece a dissipação de calor e preserva peças.</li>
          <li><strong>Otimização e formatação:</strong> organiza o sistema operacional e remove arquivos ou programas indesejados.</li>
        </ul>

        <a
          href={upgradeWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          data-track="whatsapp_click"
          data-cta-position="home_upgrades"
          data-service-category="upgrade"
        >
          Preciso melhorar meu computador
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 6 — Por que escolher a RECUPERATECH? -->
  <section class="section section--light">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Diferenciais</span>
        <h2 class="section-title">Por que escolher a RECUPERATECH?</h2>
        <p class="section-lead">
          Trabalhamos com critérios técnicos claros e comunicação direta em cada etapa do atendimento.
        </p>
      </div>

      <div class="grid-3">
        {differentials.map((item) => (
          <div class="diff-card">
            <span class="diff-card__line" aria-hidden="true"></span>
            <h3 class="diff-card__title">{item.title}</h3>
            <p class="diff-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>

      <div class="section-footer-cta">
        <a
          href={differentialsWhatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          data-track="whatsapp_click"
          data-cta-position="home_differentials"
          data-service-category="geral"
        >
          Solicitar avaliação técnica
        </a>
      </div>
    </div>
  </section>

  <!-- Seção 7 — Galeria de serviços -->
  <section class="section section--dark">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Áreas de atuação</span>
        <h2 class="section-title">Galeria de serviços e hardware</h2>
        <p class="section-lead">
          Representação visual das frentes de montagem, manutenção preventiva, upgrades e assistência técnica para desktops e notebooks.
        </p>
      </div>

      <GalleryGrid />
    </div>
  </section>

  <!-- Seção 8 — Como funciona o atendimento? -->
  <section class="section section--white">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Processo transparente</span>
        <h2 class="section-title">Como funciona o atendimento?</h2>
        <p class="section-lead">
          Fluxo objetivo para você entender o problema, conhecer o orçamento e decidir com tranquilidade.
        </p>
      </div>

      <div class="grid-4">
        {steps.map((step) => (
          <div class="step-card">
            <span class="step-card__num">{step.num}</span>
            <h3 class="step-card__title">{step.title}</h3>
            <p class="step-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Seção 9 — Perguntas frequentes -->
  <section class="section section--light" id="perguntas-frequentes">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Dúvidas comuns</span>
        <h2 class="section-title">Perguntas frequentes</h2>
        <p class="section-lead">
          Respostas diretas sobre nossos serviços, atendimento em bancada e solicitação de orçamento.
        </p>
      </div>

      <FaqAccordion items={HOME_FAQS} />
    </div>
  </section>

  <!-- Seção 10 — Localização -->
  <section class="section section--white" id="localizacao">
    <div class="container location-grid">
      <div>
        <span class="eyebrow">Onde estamos</span>
        <h2 class="section-title">Atendimento em Volta Redonda - RJ</h2>
        <p class="section-lead">
          Visite nossa unidade na Vila Santa Cecília ou entre em contato pelo WhatsApp antes de trazer o seu equipamento.
        </p>

        <div class="location-info">
          <p><strong>{SITE_CONFIG.fullTitle}</strong></p>
          <p>{SITE_CONFIG.address.full}</p>
          <p>
            Telefone / WhatsApp:{' '}
            <a href={SITE_CONFIG.phone.href} data-track="phone_click" data-cta-position="home_location">
              {SITE_CONFIG.phone.display}
            </a>
          </p>
        </div>

        <div class="location-actions">
          <a
            href={SITE_CONFIG.maps.queryUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary-light"
          >
            Abrir no Google Maps
          </a>
          <a
            href={heroWhatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--outline-red"
            data-track="whatsapp_click"
            data-cta-position="home_location"
            data-service-category="geral"
          >
            Falar no WhatsApp
          </a>
        </div>
      </div>

      <div class="location-map">
        <iframe
          title="Mapa de localização da RECUPERATECH em Volta Redonda - RJ"
          src={SITE_CONFIG.maps.embedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <CtaBlock
    title="SEU COMPUTADOR PRECISA DE ATENÇÃO?"
    subtitle="Converse com a RECUPERATECH e encontre a solução ideal para seu equipamento."
    buttonLabel="SOLICITAR ATENDIMENTO"
    ctaPosition="home_final_cta"
  />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: 3.5rem 4rem;
    border-bottom: 3px solid var(--color-red);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero {
      padding-block: 4.75rem 5.25rem;
    }
    .hero__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  .hero__location {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-red);
    margin-bottom: 0.85rem;
  }

  .hero__title {
    font-size: clamp(2.1rem, 4.4vw, 3.45rem);
    color: var(--color-white-pure);
    margin-bottom: 1.1rem;
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-light-muted);
    max-width: 54ch;
    margin-bottom: 1.85rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .hero__brand-note {
    font-size: 0.875rem;
    color: var(--color-text-light-muted);
  }

  .hero__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-dark);
    box-shadow: 0 22px 50px rgba(0, 0, 0, 0.55);
  }

  .hero__media img {
    width: 100%;
    height: auto;
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 3.5rem;
    }
  }

  .intro-grid__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--color-text-muted);
    font-size: 1.02rem;
  }

  .intro-grid__cta {
    margin-top: 0.5rem;
  }

  /* Home Service Cards */
  .home-service-card {
    background-color: var(--color-white-pure);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .home-service-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-red);
    box-shadow: var(--shadow-md);
  }

  .home-service-card__media {
    aspect-ratio: 4 / 3;
    background-color: var(--color-black);
    overflow: hidden;
  }

  .home-service-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-service-card__body {
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .home-service-card__title {
    font-size: 1.15rem;
    color: var(--color-black);
  }

  .home-service-card__desc {
    font-size: 0.935rem;
    color: var(--color-text-muted);
  }

  .home-service-card__link {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-red);
  }

  .home-service-card__link:hover {
    text-decoration: underline;
  }

  .section-footer-cta {
    margin-top: 2.5rem;
    text-align: center;
  }

  /* Split Feature */
  .split-feature {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .split-feature {
      grid-template-columns: 1fr 1fr;
      gap: 3.5rem;
    }
    .split-feature--reverse .split-feature__media {
      order: 2;
    }
  }

  .split-feature__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-dark);
    background-color: var(--color-black);
  }

  .split-feature__media img {
    width: 100%;
    height: auto;
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .check-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-text-light-muted);
  }

  .check-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52rem;
    width: 10px;
    height: 10px;
    background-color: var(--color-red);
    transform: skewX(-20deg);
  }

  .check-list--light li {
    color: var(--color-text-muted);
  }

  .check-list--light strong {
    color: var(--color-black);
  }

  /* Differentials */
  .diff-card {
    background-color: var(--color-white-pure);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .diff-card__line {
    display: block;
    width: 28px;
    height: 4px;
    background-color: var(--color-red);
    transform: skewX(-24deg);
    margin-bottom: 1rem;
  }

  .diff-card__title {
    font-size: 1.08rem;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .diff-card__desc {
    font-size: 0.925rem;
    color: var(--color-text-muted);
  }

  /* Steps */
  .step-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-gray-200);
    border-top: 3px solid var(--color-red);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }

  .step-card__num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-red);
    margin-bottom: 0.65rem;
  }

  .step-card__title {
    font-size: 1.08rem;
    color: var(--color-black);
    margin-bottom: 0.5rem;
  }

  .step-card__desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }

  /* Location */
  .location-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.25rem;
    align-items: center;
  }

  @media (min-width: 960px) {
    .location-grid {
      grid-template-columns: 0.95fr 1.05fr;
    }
  }

  .location-info {
    margin-top: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--color-text-muted);
  }

  .location-info strong {
    color: var(--color-black);
  }

  .location-info a {
    color: var(--color-red);
    font-weight: 700;
  }

  .location-actions {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .location-map {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-gray-200);
    min-height: 320px;
    background-color: var(--color-gray-100);
  }

  .location-map iframe {
    width: 100%;
    height: 340px;
    border: 0;
    display: block;
  }
</style>
