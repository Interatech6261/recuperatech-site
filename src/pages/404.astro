---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildWhatsAppUrl } from '../config/site';

const whatsappUrl = buildWhatsAppUrl();
---

<BaseLayout
  title="Página não encontrada (404) | RECUPERATECH"
  description="A página solicitada não foi encontrada no site da RECUPERATECH."
  noindex={true}
>
  <section class="section section--dark diag-grid-bg not-found">
    <div class="container not-found__inner">
      <span class="not-found__code">404</span>
      <h1 class="not-found__title">Página não encontrada</h1>
      <p class="not-found__desc">
        O endereço que você tentou acessar não está disponível ou foi movido. Você pode voltar para a página inicial, explorar nossos serviços ou falar diretamente pelo WhatsApp.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn--primary">Voltar para a Home</a>
        <a href="/servicos/" class="btn btn--secondary-dark">Ver Serviços</a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--secondary-dark"
          data-track="whatsapp_click"
          data-cta-position="404_page"
          data-service-category="geral"
        >
          Falar no WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .not-found__inner {
    max-width: 640px;
  }

  .not-found__code {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    font-weight: 800;
    color: var(--color-red);
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  .not-found__title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--color-white-pure);
    margin-bottom: 0.85rem;
  }

  .not-found__desc {
    color: var(--color-text-light-muted);
    margin-bottom: 1.75rem;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }
</style>
