---
import { buildWhatsAppUrl } from '../config/site';

const whatsappFloatUrl = buildWhatsAppUrl();
---

<a
  href={whatsappFloatUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp"
  aria-label="Solicitar atendimento pelo WhatsApp da RECUPERATECH"
  data-track="whatsapp_click"
  data-cta-position="floating_button"
  data-service-category="geral"
>
  <svg
    viewBox="0 0 24 24"
    width="26"
    height="26"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M12.031 2c-5.516 0-9.969 4.453-9.969 9.969 0 1.766.469 3.484 1.344 5l-1.406 5.156 5.281-1.375c1.469.797 3.109 1.219 4.75 1.219 5.516 0 9.969-4.453 9.969-9.969S17.547 2 12.031 2zm5.813 14.125c-.25.703-1.438 1.344-2 1.422-.531.078-1.203.109-1.938-.125-.453-.141-1.031-.344-1.766-.656-3.094-1.344-5.109-4.469-5.266-4.672-.156-.203-1.266-1.688-1.266-3.219s.797-2.281 1.078-2.594c.281-.313.625-.391.828-.391.203 0 .406.016.594.016.188 0 .453-.078.703.531.266.625.891 2.172.969 2.328.078.156.125.344.016.547-.109.203-.156.344-.313.516-.156.172-.328.391-.469.531-.156.156-.328.328-.141.656.188.328.844 1.391 1.813 2.25 1.25 1.109 2.297 1.453 2.625 1.609.328.156.516.125.703-.094.188-.219.813-.953 1.031-1.281.219-.328.438-.266.734-.156.297.109 1.875.891 2.203 1.047.328.156.547.234.625.375.078.141.078.813-.172 1.516z"
    />
  </svg>
  <span class="floating-whatsapp__label">WhatsApp</span>
</a>

<style>
  .floating-whatsapp {
    position: fixed;
    right: 1.15rem;
    bottom: 1.15rem;
    z-index: 950;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background-color: var(--color-red);
    color: var(--color-white-pure);
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: 0 10px 26px rgba(1, 1, 1, 0.32), 0 0 0 2px rgba(255, 255, 255, 0.14);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .floating-whatsapp:hover {
    background-color: var(--color-red-dark);
    transform: translateY(-2px);
  }

  .floating-whatsapp__label {
    display: none;
  }

  @media (min-width: 640px) {
    .floating-whatsapp__label {
      display: inline;
    }
  }
</style>
