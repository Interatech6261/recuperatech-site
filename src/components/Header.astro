---
import Logo from './Logo.astro';
import { NAV_LINKS, buildWhatsAppUrl } from '../config/site';

const currentPath = Astro.url.pathname;
const whatsappHeaderUrl = buildWhatsAppUrl();
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="RECUPERATECH — Página inicial">
      <Logo variant="dark" size="md" />
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      <ul class="site-nav__list">
        {NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={['site-nav__link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a
        href={whatsappHeaderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary btn--sm site-header__cta"
        data-track="whatsapp_click"
        data-cta-position="header"
        data-service-category="geral"
      >
        SOLICITAR ORÇAMENTO
      </a>

      <button
        type="button"
        class="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Abrir menu de navegação"
      >
        <span class="mobile-menu-toggle__bar"></span>
        <span class="mobile-menu-toggle__bar"></span>
        <span class="mobile-menu-toggle__bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav-drawer" class="mobile-drawer" hidden>
    <nav aria-label="Navegação mobile">
      <ul class="mobile-drawer__list">
        {NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? currentPath === '/'
              : currentPath.startsWith(link.href);
          return (
            <li>
              <a
                href={link.href}
                class:list={['mobile-drawer__link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
      <div class="mobile-drawer__cta">
        <a
          href={whatsappHeaderUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--primary"
          style="width: 100%;"
          data-track="whatsapp_click"
          data-cta-position="mobile_menu"
          data-service-category="geral"
        >
          SOLICITAR ORÇAMENTO
        </a>
      </div>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.querySelector('.mobile-menu-toggle');
    var drawer = document.getElementById('mobile-nav-drawer');
    if (!toggle || !drawer) return;

    toggle.addEventListener('click', function () {
      var expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      drawer.hidden = expanded;
      toggle.setAttribute(
        'aria-label',
        expanded ? 'Abrir menu de navegação' : 'Fechar menu de navegação'
      );
    });
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    background-color: rgba(1, 1, 1, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border-dark);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--header-height);
  }

  .site-header__brand {
    flex-shrink: 0;
  }

  .site-nav {
    display: none;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text-light-muted);
    padding-block: 0.4rem;
    position: relative;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    color: var(--color-white-pure);
  }

  .site-nav__link.is-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--color-red);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-header__cta {
    display: none;
  }

  .mobile-menu-toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    padding: 8px;
    background: var(--color-surface-dark-2);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-sm);
  }

  .mobile-menu-toggle__bar {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-white);
  }

  .mobile-drawer {
    background-color: var(--color-surface-dark);
    border-top: 1px solid var(--color-border-dark);
    padding: 1rem 1.25rem 1.5rem;
  }

  .mobile-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-drawer__link {
    display: block;
    padding: 0.85rem 0.25rem;
    font-weight: 600;
    color: var(--color-text-light-muted);
    border-bottom: 1px solid var(--color-border-dark);
  }

  .mobile-drawer__link.is-active {
    color: var(--color-white-pure);
    border-bottom-color: var(--color-red);
  }

  .mobile-drawer__cta {
    margin-top: 1rem;
  }

  @media (min-width: 640px) {
    .site-header__cta {
      display: inline-flex;
    }
  }

  @media (min-width: 1024px) {
    .site-nav {
      display: block;
    }
    .mobile-menu-toggle,
    .mobile-drawer {
      display: none !important;
    }
  }
</style>
