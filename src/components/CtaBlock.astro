---
import { buildWhatsAppUrl } from '../config/site';

interface Props {
  title: string;
  subtitle: string;
  buttonLabel?: string;
  whatsappMessage?: string;
  ctaPosition?: string;
  serviceCategory?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  subtitle,
  buttonLabel = 'SOLICITAR ATENDIMENTO',
  whatsappMessage,
  ctaPosition = 'cta_block',
  serviceCategory = 'geral',
  secondaryLabel,
  secondaryHref,
} = Astro.props;

const whatsappUrl = buildWhatsAppUrl(whatsappMessage);
---

<section class="section section--dark diag-grid-bg cta-block">
  <div class="container cta-block__inner">
    <div>
      <h2 class="cta-block__title">{title}</h2>
      <p class="cta-block__subtitle">{subtitle}</p>
    </div>
    <div class="cta-block__actions">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn--primary"
        data-track="whatsapp_click"
        data-cta-position={ctaPosition}
        data-service-category={serviceCategory}
      >
        {buttonLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="btn btn--secondary-dark">
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-block {
    border-top: 1px solid var(--color-border-dark);
  }

  .cta-block__inner {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    align-items: flex-start;
    justify-content: space-between;
  }

  @media (min-width: 768px) {
    .cta-block__inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .cta-block__title {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    color: var(--color-white-pure);
    margin-bottom: 0.6rem;
  }

  .cta-block__subtitle {
    color: var(--color-text-light-muted);
    font-size: 1.025rem;
    max-width: 56ch;
  }

  .cta-block__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    flex-shrink: 0;
  }
</style>
